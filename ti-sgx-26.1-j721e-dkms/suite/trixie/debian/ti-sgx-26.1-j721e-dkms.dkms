PACKAGE_NAME="ti-img-rogue"
PACKAGE_VERSION="#MODULE_VERSION#"
MAKE[0]="make -j$(nproc) KERNELDIR=${kernel_source_dir} RGX_BVNC=22.104.208.318 BUILD=release PVR_BUILD_DIR=j721e_linux PVR_WS=lws-generic WINDOW_SYSTEM=lws-generic"
CLEAN="rm -rf binary_j721e_linux_lws-generic_release"
BUILT_MODULE_NAME[0]="pvrsrvkm"
BUILT_MODULE_LOCATION[0]="binary_j721e_linux_lws-generic_release/target_aarch64/"
DEST_MODULE_LOCATION[0]="/updates/dkms"
BUILD_EXCLUSIVE_ARCH="aarch64"
AUTOINSTALL="yes"
