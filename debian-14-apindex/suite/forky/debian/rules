#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
export DH_VERBOSE=1

override_dh_auto_configure:
	git -c http.sslVerify=false clone -b bbbio-20231128 https://openbeagle.org/RobertCNelson/apindex-v2.git --depth=1 ./src/
	cd ./src/ ; cmake . -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_INSTALL_PREFIX=./tmp ; make install

%:
	dh $@

override_dh_builddeb:
	dh_builddeb -- -Zxz
